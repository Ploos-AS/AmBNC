/* Force only alpha off, allow bounded reconnect, and leave beta untouched. */
OPTIONS RESULTS
ADDRESS 'AMBNC' 'RAW PRIVMSG #ambnc :M8_2_DROP_ALPHA'
SAY 'DROP_ALPHA: RC=' || RC 'RESULT=' || RESULT
IF RC ~= 0 THEN EXIT 10
ADDRESS COMMAND 'Wait 20 SECS'
ADDRESS 'AMBNC' 'STATUS'
SAY 'POST_RECONNECT_STATUS: RC=' || RC 'RESULT=' || RESULT
IF RC ~= 0 THEN EXIT 10
SAY 'M8_2_DROP_ALPHA_SENT=PASS'
EXIT 0
