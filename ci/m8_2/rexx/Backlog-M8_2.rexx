/* Run only after detaching the alpha downstream client. */
OPTIONS RESULTS
ADDRESS 'AMBNC' 'MSG #ambnc M8_2_BACKLOG_ALPHA'
SAY 'BACKLOG_MSG: RC=' || RC 'RESULT=' || RESULT
IF RC ~= 0 THEN EXIT 10
ADDRESS COMMAND 'Wait 2 SECS'
ADDRESS 'AMBNC' 'BUFFER'
SAY 'BACKLOG_BUFFER: RC=' || RC 'RESULT=' || RESULT
IF RC ~= 0 THEN EXIT 10
IF POS('lines=0', RESULT) > 0 THEN DO
  SAY 'M8_2_BACKLOG_COLLECTION=FAIL'
  EXIT 10
END
SAY 'M8_2_BACKLOG_COLLECTION=PASS'
EXIT 0
